# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matched by the *.local pattern) - never commit real credentials.

# Supabase project URL and publishable (anon) key.
# Found in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# NOTE: The anon key above is safe to expose in client-side code by design -
# Supabase's Row Level Security (RLS) policies are what actually protect data,
# not the secrecy of this key.

# Service role key - full admin access, bypasses RLS entirely. Deliberately
# NOT prefixed with VITE_ so Vite never bundles it into client-side code.
# Only ever read by serverless functions in /api (Node.js, server-side only).
# Found in the same Settings -> API page, below the anon key, usually
# hidden behind a "Reveal" toggle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
