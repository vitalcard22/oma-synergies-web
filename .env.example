# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matched by the *.local pattern) - never commit real credentials.

# Supabase project URL and publishable (anon) key.
# Found in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# NOTE: The anon key above is safe to expose in client-side code by design -
# Supabase's Row Level Security (RLS) policies are what actually protect data,
# not the secrecy of this key. Never put the SERVICE ROLE key here or in any
# client-side file - that one has full admin access and must only ever live
# in server-side environment variables (Vercel serverless function config),
# never in the browser bundle.
